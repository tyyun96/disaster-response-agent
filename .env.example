# 이 파일을 .env 로 복사한 뒤 값을 채워주세요.  (cp .env.example .env)
# .env 는 .gitignore 에 포함되어 있어 GitHub에 올라가지 않습니다.

# --- OpenAI (필수) ---
OPENAI_API_KEY=
# 사용할 모델 (기본값: gpt-4o)
# OPENAI_MODEL=gpt-4o

# --- NAVER 검색 API (뉴스) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- KAKAO REST API (지오코딩 / GPS 주소 변환) ---
KAKAO_REST_API_KEY=

# --- Threads API (SNS) ---
THREADS_ACCESS_TOKEN=

# --- Google / YouTube Data API (SNS) ---
YOUTUBE_API_KEY=

# --- 재난안전데이터공유플랫폼 (safetydata.go.kr) API 키 ---
YONHAP_NEWS_API_KEY=
DISASTER_MESSAGE_API_KEY=
FOREST_FIRES_API_KEY=
KMA_WEATHER_API_KEY=
# API 경로를 바꿔야 할 때만 설정
# YONHAP_API_PATH=DSSP-IF-10747
# KMA_WARNING_API_PATH=DSSP-IF-00045

# --- REST API 서버(apps/api.py) 보호용 키: 설정하면 x-api-key 헤더 검사 ---
# EXTERNAL_API_KEY=

# --- 카카오 챗봇 응답 방식: collect(수집 요약, 기본값) | kpas(재난문자 초안) ---
# KAKAO_MODE=collect

# --- 디버그: 1이면 하위 에이전트의 전체 실행 로그 출력 ---
# AGENT_VERBOSE=0

# --- (선택) MCP 서버 실행 설정: 비워두면 현재 Python / 패키지 내부 경로를 자동 사용 ---
# PYTHON_EXECUTABLE_PATH=
# MCP_SERVER_SCRIPT_DIR=
